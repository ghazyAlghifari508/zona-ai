# DATABASE
# Server-only, Required, All environments
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://zona:password@localhost:5432/zona_ai

# AUTH (Better Auth)
# Server-only, Required, All environments
# Format: Random string, minimum 32 characters
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here-change-me
# Server-only, Required, All environments
# Format: Full URL
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (Required for Authentication)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret


# 9ROUTER (AI Gateway)
# Server-only, Required, All environments
# Format: URL ending with /v1
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# Server-only, Required, All environments
NINE_ROUTER_API_KEY=your-9router-api-key

# R2 (Cloudflare R2 Object Storage)
# Server-only, Required, All environments
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=zona-ai-files
# Server-only, Optional
R2_PUBLIC_URL=https://files.zona.ai

# TAVILY (Web Search)
# Server-only, Required, All environments
# Format: tvly-...
TAVILY_API_KEY=tvly-your-tavily-api-key

# EXA (Advanced Research - Future)
# Server-only, Optional (not needed for MVP)
EXA_API_KEY=your-exa-api-key

# LANGFUSE (AI Observability)
# Server-only, Required for observability, Optional for MVP dev
# Format: sk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-54a28432-e48b-4894-b65f-434e56814601
# Server-only, Required for observability
# Format: pk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-95079f67-d33f-4fd1-84e4-fda78fc88c77
# Server-only, Optional (defaults to cloud.langfuse.com)
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# APP (Application)
# Shared (SSR), Required, All environments
APP_URL=http://localhost:3000
# Shared, Auto-set by runtime
# Values: development, production, test
# NODE_ENV=development

# RATE LIMITING (Fase 10 Hardening) - Server-only, Optional
# In-memory per-user rate limits. 429 ERR-017 + Retry-After when exceeded.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_COMPARE_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=30
